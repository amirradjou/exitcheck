# Copy to .env and fill in. Never commit .env.

# Optional. Without a key, a contract not verified on Sourcify or Blockscout is reported as "unknown" rather than
# "not verified" (Etherscan, where most tokens are verified, refuses keyless calls). Free key: etherscan.io/apis
# ETHERSCAN_API_KEY=

# Optional RPC overrides. The defaults are free public endpoints (publicnode for latest state; mevblocker and
# Tenderly's gateway for archive state and logs). One URL here replaces both; it must serve archive state.
# RUGCHECK_RPC_ETHEREUM=https://eth-mainnet.g.alchemy.com/v2/<key>
# RUGCHECK_RPC_BASE=https://base-mainnet.g.alchemy.com/v2/<key>
# Or replace only the archive endpoint:
# RUGCHECK_ARCHIVE_RPC_ETHEREUM=
# RUGCHECK_ARCHIVE_RPC_BASE=

# The Telegram bot (`rugcheck bot`, `make bot`). Create a bot with @BotFather and paste its token.
# TELEGRAM_BOT_TOKEN=
# Answer cache; `make bot` starts Redis from compose.yaml and defaults to this URL.
# REDIS_URL=redis://localhost:6379/0

# Live watch alerts (`docker compose up -d`): a channel where the bot is an admin, as @username or numeric -100… ID.
# Without it, alerts are stored in Postgres and logged, not posted.
# TELEGRAM_ALERTS_CHAT=@yourchannel

# Optional: the plain-words "why" under a verdict (`rugcheck explain`, the bot). Any OpenAI-compatible endpoint. The
# verdict never depends on it; without these the bot answers with the verdict alone.
# A free tier, no card:   RUGCHECK_LLM_URL=https://api.groq.com/openai/v1  RUGCHECK_LLM_KEY=…  RUGCHECK_LLM_MODEL=qwen/qwen3.8-27b
# Local, no key:          RUGCHECK_LLM_URL=http://localhost:11434/v1  RUGCHECK_LLM_MODEL=qwen2.5:7b
# RUGCHECK_LLM_URL=
# RUGCHECK_LLM_MODEL=
# RUGCHECK_LLM_KEY=
